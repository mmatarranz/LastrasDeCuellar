          {
            "id": "7914cefd",
            "elType": "widget",
            "settings": {
              "title": "Juan Enrique del Barrio",
              "title_color": "#000000",
              "typography_typography": "custom",
              "typography_font_size": {
                "unit": "px",
                "size": 32
              },
              "align": "left",
