        "id": "66951bc",
        "elType": "widget",
        "settings": {
          "editor": "<h2>Datos técnicos de la presa:</h2>\n<p> </p>\n<table cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\"><b>DATOS GENERALES</b></span></p>\n</td>\n<td valign=\"middle\"> </td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Nombre de la Presa:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Bodón de la Ibienza</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Tipo de presa:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Helvetica Neue; font-size: small;\">Arco de gravedad</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Altura desde cimientos (m):</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">10,000</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Longitud de coronación (m):</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">64,000</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Titular de la presa:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">JUAN FRUTOS GARCIA S.A.</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Proyectista:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">J-COBELAS SCHWARTZ</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Inicio construcción:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Helvetica Neue; font-size: small;\">1964</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Fin de las obras:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">31-12-1967</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Coordenadas UTM 30:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">0403360 – 4572135</span></p>\n</td>\n</tr>\n<tr>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Usos del embalse:</span></p>\n</td>\n<td valign=\"middle\">\n<p><span style=\"color: #000000; font-family: Times; font-size: medium;\">Hidroeléctrico – –</span></p>\n</td>\n</tr>\n</tbody>\n</table>"
        },
