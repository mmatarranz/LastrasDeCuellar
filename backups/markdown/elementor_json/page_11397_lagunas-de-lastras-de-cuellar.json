          {
            "id": "ca32dc6",
            "elType": "widget",
            "settings": {
              "title": "Especies vegetales y animales",
              "typography_typography": "custom",
              "typography_font_size": {
                "unit": "px",
                "size": 35,
                "sizes": []
              }
            },
            "elements": [],
