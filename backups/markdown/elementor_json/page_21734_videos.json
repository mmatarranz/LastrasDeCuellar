            "settings": {
              "_title": "Estilos CSS Videoteca Stitch 2026",
              "html": "<style>\n/* Estilos Página de Vídeos - Stitch Edition 2026 */\n.videos-header-box {\n    margin-bottom: 2.5rem;\n    padding-bottom: 2rem;\n    border-bottom: 1px solid rgba(22, 28, 34, 0.08);\n}\n.videos-top-meta {\n    display: flex;\n    flex-direction: row;\n    justify-content: space-between;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 1rem;\n    margin-bottom: 1.2rem;\n}\n.videos-badge-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(164, 60, 27, 0.08);\n    border: 1px solid rgba(164, 60, 27, 0.2);\n    border-radius: 9999px;\n    padding: 4px 14px;\n}\n.videos-badge-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background-color: #A43C1B;\n    box-shadow: 0 0 8px #A43C1B;\n}\n.videos-badge-text {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.74rem;\n    font-weight: 800;\n    color: #A43C1B;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n}\n\n\n.videos-title {\n    font-family: 'Playfair Display', serif;\n    font-size: 2.7rem;\n    font-weight: 700;\n    color: #151C22;\n    margin: 0 0 0.6rem 0;\n    line-height: 1.2;\n    letter-spacing: -0.01em;\n}\n.videos-subtitle {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 1.08rem;\n    color: #555555;\n    line-height: 1.55;\n    margin: 0;\n    max-width: 820px;\n}\n\n/* Featured Video Hero Box */\n.videos-featured-wrapper {\n    box-shadow: 0 16px 40px rgba(28, 25, 23, 0.15) !important;\n}\n.featured-badge-row {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 0.8rem;\n}\n.featured-pill-badge {\n    display: inline-block;\n    background: #A43C1B;\n    color: #FFFFFF;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.7rem;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n    padding: 3px 12px;\n    border-radius: 9999px;\n}\n.featured-duration-badge {\n    color: #A8A29E;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.75rem;\n    font-weight: 600;\n}\n.featured-video-title {\n    font-family: 'Playfair Display', serif;\n    font-size: 1.85rem;\n    font-weight: 700;\n    color: #FFFFFF;\n    margin: 0 0 0.5rem 0;\n    line-height: 1.25;\n}\n.featured-video-subtitle {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.95rem;\n    color: #D6D3D1;\n    margin: 0 0 1.5rem 0;\n    line-height: 1.5;\n    max-width: 780px;\n}\n\n/* Section Divider Headers */\n.section-divider-header {\n    margin: 3.5rem 0 1.8rem 0;\n    padding-bottom: 0.8rem;\n    border-bottom: 1px solid rgba(22, 28, 34, 0.08);\n}\n.section-kicker {\n    display: block;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.72rem;\n    font-weight: 800;\n    color: #A43C1B;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    margin-bottom: 0.35rem;\n}\n.section-main-heading {\n    font-family: 'Playfair Display', serif;\n    font-size: 2rem;\n    font-weight: 700;\n    color: #151C22;\n    margin: 0 0 0.4rem 0;\n}\n.section-sub-heading {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.98rem;\n    color: #666666;\n    margin: 0;\n    max-width: 750px;\n    line-height: 1.5;\n}\n\n/* YouTube Video Grid Cards */\n.video-grid-card {\n    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease !important;\n    overflow: hidden !important;\n    box-shadow: 0 4px 18px rgba(30, 37, 43, 0.04) !important;\n}\n.video-grid-card:hover {\n    transform: translateY(-6px) !important;\n    box-shadow: 0 16px 36px rgba(30, 37, 43, 0.1) !important;\n    border-color: rgba(164, 60, 27, 0.3) !important;\n}\n.video-grid-card .elementor-widget-video {\n    margin-bottom: 0 !important;\n}\n.video-card-meta-box {\n    padding: 1.25rem 1.35rem 1.4rem 1.35rem;\n    display: flex;\n    flex-direction: column;\n}\n.video-card-tag {\n    display: inline-block;\n    align-self: flex-start;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.68rem;\n    font-weight: 800;\n    color: #A43C1B;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    background: rgba(164, 60, 27, 0.08);\n    padding: 2px 9px;\n    border-radius: 9999px;\n    margin-bottom: 0.6rem;\n}\n.video-card-title {\n    font-family: 'Playfair Display', serif;\n    font-size: 1.18rem;\n    font-weight: 700;\n    color: #151C22;\n    line-height: 1.35;\n    margin: 0 0 0.5rem 0;\n}\n.video-card-desc {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 0.85rem;\n    color: #666666;\n    line-height: 1.5;\n    margin: 0;\n}\n\n/* Dynamic Posts Grid Styling */\n.elementor-element-videos_posts_grid .elementor-posts-container {\n    display: grid !important;\n    grid-template-columns: repeat(3, 1fr) !important;\n    gap: 1.75rem !important;\n    width: 100% !important;\n}\n.elementor-element-videos_posts_grid .elementor-post {\n    background: #FFFFFF !important;\n    border-radius: 18px !important;\n    border: 1px solid rgba(22, 28, 34, 0.08) !important;\n    overflow: hidden !important;\n    box-shadow: 0 4px 18px rgba(30, 37, 43, 0.04) !important;\n    display: flex !important;\n    flex-direction: column !important;\n    justify-content: space-between !important;\n    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease !important;\n}\n.elementor-element-videos_posts_grid .elementor-post:hover {\n    transform: translateY(-6px) !important;\n    box-shadow: 0 16px 36px rgba(30, 37, 43, 0.1) !important;\n    border-color: rgba(164, 60, 27, 0.3) !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__thumbnail__link {\n    display: block !important;\n    width: 100% !important;\n    margin-bottom: 0 !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__thumbnail {\n    aspect-ratio: 16 / 10 !important;\n    overflow: hidden !important;\n    background-color: #EAE6DF !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__thumbnail img {\n    width: 100% !important;\n    height: 100% !important;\n    object-fit: cover !important;\n    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important;\n}\n.elementor-element-videos_posts_grid .elementor-post:hover .elementor-post__thumbnail img {\n    transform: scale(1.06) !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__text {\n    padding: 1.45rem 1.4rem 1.5rem 1.4rem !important;\n    display: flex !important;\n    flex-direction: column !important;\n    flex-grow: 1 !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__meta-data {\n    font-family: 'Plus Jakarta Sans', sans-serif !important;\n    font-size: 0.72rem !important;\n    font-weight: 800 !important;\n    color: #A43C1B !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.08em !important;\n    margin-bottom: 0.55rem !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__title {\n    font-family: 'Playfair Display', serif !important;\n    font-size: 1.25rem !important;\n    font-weight: 700 !important;\n    line-height: 1.35 !important;\n    margin: 0 0 0.7rem 0 !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__title a {\n    color: #151C22 !important;\n    text-decoration: none !important;\n    transition: color 0.2s ease !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__title a:hover {\n    color: #A43C1B !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__excerpt p {\n    font-family: 'Plus Jakarta Sans', sans-serif !important;\n    font-size: 0.88rem !important;\n    color: #555555 !important;\n    line-height: 1.55 !important;\n    margin: 0 0 1.2rem 0 !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__read-more {\n    margin-top: auto !important;\n    align-self: flex-start !important;\n    font-family: 'Plus Jakarta Sans', sans-serif !important;\n    font-size: 0.82rem !important;\n    font-weight: 800 !important;\n    color: #A43C1B !important;\n    text-decoration: none !important;\n    border-bottom: 1.5px solid transparent !important;\n    padding-bottom: 2px !important;\n    transition: all 0.2s ease !important;\n}\n.elementor-element-videos_posts_grid .elementor-post__read-more:hover {\n    border-bottom-color: #A43C1B !important;\n    transform: translateX(3px) !important;\n}\n\n/* Responsive Breakpoints */\n@media (max-width: 1024px) {\n    .video-grid-card {\n        width: calc(50% - 12px) !important;\n    }\n    .elementor-element-videos_posts_grid .elementor-posts-container {\n        grid-template-columns: repeat(2, 1fr) !important;\n    }\n    .videos-title {\n        font-size: 2.2rem;\n    }\n}\n@media (max-width: 640px) {\n    .video-grid-card {\n        width: 100% !important;\n    }\n    .elementor-element-videos_posts_grid .elementor-posts-container {\n        grid-template-columns: 1fr !important;\n    }\n    .videos-title {\n        font-size: 1.85rem;\n    }\n    .videos-featured-wrapper {\n        padding: 1.5rem !important;\n    }\n    .featured-video-title {\n        font-size: 1.4rem;\n    }\n}\n</style>"
            },
            "elements": []
          },
